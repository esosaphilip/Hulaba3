## Root .gitignore for Android + React/Vite project

# OS / Editor
.DS_Store
.vscode/
.idea/
*.iml

# Gradle and Kotlin caches
.gradle/
.kotlin/

# Android build outputs
/build/
/app/build/
**/captures/
.externalNativeBuild/
.cxx/
local.properties
*.apk
*.aab

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node / Vite outputs
node_modules/
dist/
dist-ssr/
*.local

# Misc
build_last.txt